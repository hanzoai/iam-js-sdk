{
  "name": "@hanzo/iam-js-sdk",
  "version": "0.19.2",
  "description": "Javascript client SDK for IAM",
  "main": "lib/cjs/index.js",
  "typings": "lib/cjs/index.d.ts",
  "module": "lib/esm/index.js",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "run-s build",
    "postpack": "run-s clean",
    "build": "run-s clean && run-p build:*",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "clean": "rimraf lib",
    "test": "jest",
    "coverage": "jest --coverage",
    "semantic-release": "semantic-release"
  },
  "jest": {
    "maxConcurrency": 1,
    "maxWorkers": 1,
    "testTimeout": 30000,
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.12",
    "typescript": "7.0.2"
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "auth",
    "authn",
    "authentication",
    "sso",
    "oauth",
    "oidc",
    "casbin",
    "iam"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/iam-js-sdk.git"
  },
  "author": {
    "name": "Zxilly",
    "email": "zxilly@outlook.com"
  },
  "bugs": {
    "url": "https://github.com/hanzoai/iam-js-sdk/issues"
  },
  "homepage": "https://github.com/hanzoai/iam-js-sdk",
  "dependencies": {
    "js-pkce": "^2.0.0",
    "jwt-decode": "^4.0.0"
  }
}
